# Copy to backend/.env and fill in. Validated at startup (src/config/env.ts): the process
# exits with a clear message if a required value is missing or malformed.

# ---------- Server ----------
# development | production | test
NODE_ENV=development
# Port the Express API listens on
PORT=4000
# Frontend origin: CORS allow-list and where users land after login
FRONTEND_URL=http://localhost:5173
# Signs the session cookie and the Slack OAuth state (min 16 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# ---------- Data stores ----------
# Local values match docker-compose.yml (`docker compose up -d`).

# PostgreSQL used by the app (hosted Neon: pooled URL + ?sslmode=require)
DATABASE_URL=postgresql://mailpilot:mailpilot@localhost:5432/mailpilot
# Direct (non-pooled) connection used only by `prisma migrate`; locally the same as DATABASE_URL
DIRECT_URL=postgresql://mailpilot:mailpilot@localhost:5432/mailpilot

# Redis for BullMQ jobs and rate-limit counters (rediss:// for TLS; must use maxmemory-policy noeviction)
REDIS_URL=redis://localhost:6379

# OpenSearch / Elasticsearch URL. Optional: leave empty and search falls back to Postgres
ELASTICSEARCH_URL=http://localhost:9200
# Optional API key, sent as `Authorization: ApiKey <key>`
ELASTICSEARCH_API_KEY=
# Name of the search index (created on first boot)
ELASTICSEARCH_INDEX=mailpilot-emails

# ---------- Google OAuth (login) ----------
# OAuth client ID from Google Cloud Console
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# OAuth client secret from Google Cloud Console
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must match an authorized redirect URI; goes through the Vite proxy so the cookie is set on the frontend origin
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback

# ---------- Slack OAuth (rate-limit alerts, optional) ----------
# Slack app client ID (Basic Information → App Credentials)
SLACK_CLIENT_ID=your-slack-client-id
# Slack app client secret
SLACK_CLIENT_SECRET=your-slack-client-secret
# Redirect URL registered in the Slack app
SLACK_REDIRECT_URI=http://localhost:5173/api/slack/callback

# ---------- Scheduler tuning ----------
# true = also run the BullMQ worker inside the API process (single-service hosting)
RUN_WORKER_IN_API=false
# Jobs processed in parallel per worker process
WORKER_CONCURRENCY=5
# Minimum gap between two sends from the same sender, in ms (shared by all workers via Redis)
MIN_DELAY_BETWEEN_SENDS_MS=2000
# Default hourly cap per sender (a sender row can override it; a campaign can set a lower one)
MAX_EMAILS_PER_HOUR_PER_SENDER=200
