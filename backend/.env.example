# ---------- Server ----------
NODE_ENV=development
PORT=4000
# Frontend origin (Vite dev server proxies /api to this backend)
FRONTEND_URL=http://localhost:5173
# Any long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-string

# ---------- Data stores ----------
# Hosted (used during development): Neon Postgres, Redis Cloud, Bonsai OpenSearch.
# Local Docker (`docker compose up -d`) values are shown in the comments.

# Postgres. Neon: the pooled connection string + ?sslmode=require
# Local: postgresql://reachinbox:reachinbox@localhost:5432/reachinbox
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# Non-pooled connection used only by `prisma migrate` (Neon: same URL without "-pooler"; local: same as DATABASE_URL)
DIRECT_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Redis. Use rediss:// for TLS. Must not evict keys (maxmemory-policy noeviction).
# Local: redis://localhost:6379
REDIS_URL=redis://default:password@host:6379

# Elasticsearch-compatible search (OpenSearch on Bonsai): https://key:secret@host:443
# Local: http://localhost:9200. Optional: if empty, search falls back to Postgres.
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=reachinbox-emails

# ---------- Google OAuth ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Goes through the Vite proxy so the auth cookie is set on the frontend origin
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback

# ---------- Slack OAuth ----------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Slack accepts plain http://localhost redirect URLs for development
SLACK_REDIRECT_URI=http://localhost:5173/api/slack/callback

# ---------- Scheduler tuning ----------
# Jobs processed in parallel per worker process
WORKER_CONCURRENCY=5
# Minimum gap between two sends from the SAME sender (Redis-backed, shared by all workers)
MIN_DELAY_BETWEEN_SENDS_MS=2000
# Default hourly cap per sender (a sender row can override it; a campaign may set a lower one)
MAX_EMAILS_PER_HOUR_PER_SENDER=200
